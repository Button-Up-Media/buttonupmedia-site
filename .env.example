# =============================================================================
# Meta (Facebook) API Configuration - "Chef Mark" App
# =============================================================================
# IMPORTANT: Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# Meta App Credentials
META_APP_ID=1484237219303205
META_APP_SECRET=your_app_secret_here

# Meta API Version (current latest)
META_API_VERSION=v25.0

# Graph API Base URL
META_GRAPH_API_BASE=https://graph.facebook.com

# Instagram Graph API Base URL
META_INSTAGRAM_API_BASE=https://graph.instagram.com

# Access Tokens (generated after System User Account setup)
# These will be populated once the System User is created in Business Manager
META_SYSTEM_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Business Manager ID (from your Meta Business Suite)
META_BUSINESS_ID=

# Ad Account ID (format: act_XXXXXXXXXX)
META_AD_ACCOUNT_ID=

# Facebook Page ID (the page connected to your business)
META_PAGE_ID=

# Instagram Business Account ID (connected to your Facebook Page)
META_INSTAGRAM_ACCOUNT_ID=

# Webhook Verification Token (any random string you choose for webhook security)
META_WEBHOOK_VERIFY_TOKEN=

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
